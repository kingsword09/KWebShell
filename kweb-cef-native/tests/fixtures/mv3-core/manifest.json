{
  "manifest_version": 3,
  "name": "KWebShell MV3 core conformance",
  "version": "1",
  "key": "",
  "background": {
    "service_worker": "worker.js"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KWebShell MV3 action"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kwebshell.test/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
