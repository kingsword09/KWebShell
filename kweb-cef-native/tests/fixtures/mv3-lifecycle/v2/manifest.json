{
  "manifest_version": 3,
  "name": "KWebShell MV3 lifecycle conformance",
  "version": "2.0.0",
  "key": "",
  "background": {
    "service_worker": "worker.js"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
