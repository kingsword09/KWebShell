{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kwebshell.dev/schemas/rfc-evidence-manifest-v2.json",
  "title": "KWebShell RFC capability evidence manifest",
  "description": "Machine-readable capability evidence for the KWebShell RFC program (RFC 0001). The deterministic Kotlin validator in kweb-rfc-governance is the enforcement engine; this packaged document is the versioned format contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordsSha256", "records"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "recordsSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 over the compact canonical serialization of the sorted records array."
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rfcId",
          "rfcStatus",
          "serviceId",
          "serviceVersion",
          "schemaVersion",
          "providerId",
          "target",
          "cefVersion",
          "chromiumVersion",
          "electronFixtureMajor",
          "run",
          "contractSha256",
          "compatibilityStatus",
          "matrixRowIds",
          "artifacts"
        ],
        "properties": {
          "rfcId": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          },
          "rfcStatus": {
            "const": "Implemented"
          },
          "serviceId": {
            "type": ["string", "null"],
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "serviceVersion": {
            "type": ["string", "null"],
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "schemaVersion": {
            "const": 2
          },
          "providerId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "target": {
            "enum": ["macos-arm64", "windows-x64", "linux-x64"]
          },
          "cefVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "chromiumVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "electronFixtureMajor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "run": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "workflowRef", "runId", "runAttempt", "sourceRevision"],
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
              },
              "workflowRef": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_./@-]{1,256}$"
              },
              "runId": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,19}$"
              },
              "runAttempt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999
              },
              "sourceRevision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          },
          "contractSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "compatibilityStatus": {
            "enum": ["READY", "BLOCKED"]
          },
          "matrixRowIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,63}$"
            }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "path", "sha256"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
                },
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
