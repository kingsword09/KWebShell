+namespace {
+
+constexpr size_t kMaximumPathSize = 32768;
+constexpr size_t kMaximumProxyRulesSize = 8192;
+constexpr size_t kMaximumPacUrlSize = 8192;
+constexpr size_t kMaximumBypassListSize = 8192;
+constexpr size_t kMaximumUserAgentSize = 1024;
+constexpr size_t kMaximumAcceptLanguageSize = 1024;
+
+struct ProfileState final {
+  bool configured = false;
+  bool network_context_created = false;
+  net::ProxyConfigWithAnnotation proxy_config;
+  std::string user_agent;
+  std::string accept_language;
+  std::string default_accept_language;
+  bool default_accept_language_captured = false;
+  mojo::RemoteSet<network::mojom::ProxyConfigClient> proxy_clients;
+};
+
+using StateMap = std::map<base::FilePath, std::unique_ptr<ProfileState>>;
+
+StateMap& States() {
+  static base::NoDestructor<StateMap> states;
+  return *states;
+}
+
+std::string CopyString(cef_kweb_network_string_view value,
+                       size_t maximum,
+                       bool required) {
+  if (value.data == nullptr && value.size != 0) {
+    return {};
+  }
+  if (value.size > maximum || (required && value.size == 0)) {
+    return {};
+  }
+  return std::string(value.data == nullptr ? "" : value.data, value.size);
+}
+
+bool IsSafeNetworkContextValue(std::string_view value) {
+  for (const unsigned char character : value) {
+    if (character < 0x20 || character == 0x7f) {
+      return false;
+    }
+  }
+  return true;
+}
+
+base::FilePath PathFromString(const std::string& value) {
+  return base::FilePath::FromUTF8Unsafe(value);
+}
+
+const net::NetworkTrafficAnnotationTag& TrafficAnnotation() {
+  static const auto annotation =
+      net::DefineNetworkTrafficAnnotation("kwebshell_profile_proxy", R"(
+        semantics {
+          sender: "KWebShell Profile Network Policy"
+          description:
+            "Applying an explicit Profile-scoped proxy configuration to an embedded Chromium NetworkContext."
+          trigger:
+            "Whenever a KWebShell Profile is opened or its network policy is replaced."
+          data:
+            "Proxy rules, bypass entries, or a PAC URL supplied by the application."
+          destination: OTHER
+          destination_other:
+            "The proxy or origin network selected by the Profile policy."
+          internal {
+            contacts {
+              owners: "//tools/traffic_annotation/OWNERS"
+            }
+          }
+          last_reviewed: "2026-09-28"
+          user_data {
+            type: ARBITRARY_DATA
+          }
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "The application explicitly opts into this Profile-scoped network policy."
+          policy_exception_justification:
+            "The proxy policy is part of the embedding application's declared Profile contract."
+        })");
+  return annotation;
+}
+
+std::string_view TrimAscii(std::string_view value) {
+  while (!value.empty() && base::IsAsciiWhitespace(value.front())) {
+    value.remove_prefix(1);
+  }
+  while (!value.empty() && base::IsAsciiWhitespace(value.back())) {
+    value.remove_suffix(1);
+  }
+  return value;
+}
+
+bool ValidateProxyList(std::string_view value,
+                       net::ProxyServer::Scheme default_scheme) {
+  if (value.empty()) {
+    return false;
+  }
+  size_t start = 0;
+  while (start <= value.size()) {
+    const size_t end = value.find(',', start);
+    const std::string_view entry = TrimAscii(value.substr(
+        start,
+        end == std::string_view::npos ? std::string_view::npos : end - start));
+    if (entry.empty() ||
+        !net::ProxyUriToProxyChain(entry, default_scheme).IsValid()) {
+      return false;
+    }
+    if (end == std::string_view::npos) {
+      break;
+    }
+    start = end + 1;
+  }
+  return true;
+}
+
+bool ValidateFixedProxyRules(std::string_view value) {
+  if (value.empty()) {
+    return false;
+  }
+  std::set<std::string> schemes;
+  size_t start = 0;
+  size_t clause_index = 0;
+  while (start <= value.size()) {
+    const size_t end = value.find(';', start);
+    const std::string_view clause = TrimAscii(value.substr(
+        start,
+        end == std::string_view::npos ? std::string_view::npos : end - start));
+    if (clause.empty()) {
+      return false;
+    }
+    const size_t equals = clause.find('=');
+    if (equals == std::string_view::npos) {
+      return clause_index == 0 && end == std::string_view::npos &&
+             ValidateProxyList(clause, net::ProxyServer::SCHEME_HTTP);
+    }
+    if (clause.find('=', equals + 1) != std::string_view::npos) {
+      return false;
+    }
+    const std::string_view scheme = TrimAscii(clause.substr(0, equals));
+    const std::string_view proxies = TrimAscii(clause.substr(equals + 1));
+    net::ProxyServer::Scheme default_scheme = net::ProxyServer::SCHEME_HTTP;
+    if (scheme == "socks") {
+      default_scheme = net::ProxyServer::SCHEME_SOCKS4;
+    } else if (scheme != "http" && scheme != "https" && scheme != "ftp") {
+      return false;
+    }
+    if (!schemes.insert(std::string(scheme)).second ||
+        !ValidateProxyList(proxies, default_scheme)) {
+      return false;
+    }
+    ++clause_index;
+    if (end == std::string_view::npos) {
+      break;
+    }
+    start = end + 1;
+  }
+  return clause_index > 0;
+}
+
+bool ValidateBypassRules(std::string_view value) {
+  if (value.empty()) {
+    return true;
+  }
+  net::ProxyHostMatchingRules parsed_rules;
+  size_t start = 0;
+  while (start <= value.size()) {
+    const size_t end = value.find_first_of(",;", start);
+    const std::string_view entry = TrimAscii(value.substr(
+        start,
+        end == std::string_view::npos ? std::string_view::npos : end - start));
+    if (entry.empty() || !parsed_rules.AddRuleFromString(entry)) {
+      return false;
+    }
+    if (end == std::string_view::npos) {
+      break;
+    }
+    start = end + 1;
+  }
+  return true;
+}
+
+std::optional<net::ProxyConfigWithAnnotation> BuildProxyConfig(
+    const cef_kweb_network_proxy_config_t& config) {
+  if (config.pac_mandatory > 1) {
+    return std::nullopt;
+  }
+  net::ProxyConfig proxy;
+  switch (config.mode) {
+    case CEF_KWEB_NETWORK_PROXY_DIRECT:
+      if (config.pac_mandatory != 0 || config.proxy_rules.size != 0 ||
+          config.pac_url.size != 0 || config.bypass_list.size != 0) {
+        return std::nullopt;
+      }
+      proxy = net::ProxyConfig::CreateDirect();
+      break;
+    case CEF_KWEB_NETWORK_PROXY_FIXED: {
+      if (config.pac_mandatory != 0 || config.pac_url.size != 0) {
+        return std::nullopt;
+      }
+      const std::string rules = CopyString(
+          config.proxy_rules, kMaximumProxyRulesSize, /*required=*/true);
+      if (!ValidateFixedProxyRules(rules)) {
+        return std::nullopt;
+      }
+      proxy.proxy_rules().ParseFromString(rules);
+      if (proxy.proxy_rules().empty()) {
+        return std::nullopt;
+      }
+      const std::string bypass = CopyString(
+          config.bypass_list, kMaximumBypassListSize, /*required=*/false);
+      if ((config.bypass_list.size != 0 && bypass.empty()) ||
+          !ValidateBypassRules(bypass)) {
+        return std::nullopt;
+      }
+      proxy.proxy_rules().bypass_rules.ParseFromString(bypass);
+      break;
+    }
+    case CEF_KWEB_NETWORK_PROXY_PAC: {
+      if (config.proxy_rules.size != 0 || config.bypass_list.size != 0) {
+        return std::nullopt;
+      }
+      const std::string pac_url =
+          CopyString(config.pac_url, kMaximumPacUrlSize, /*required=*/true);
+      const GURL url(pac_url);
+      if (!url.is_valid() ||
+          (!url.SchemeIs("http") && !url.SchemeIs("https"))) {
+        return std::nullopt;
+      }
+      proxy = net::ProxyConfig::CreateFromCustomPacURL(url);
+      proxy.set_pac_mandatory(config.pac_mandatory != 0);
+      break;
+    }
+    default:
+      return std::nullopt;
+  }
+  return net::ProxyConfigWithAnnotation(proxy, TrafficAnnotation());
+}
+
+ProfileState* FindState(const base::FilePath& profile_path) {
+  auto found = States().find(profile_path);
+  return found == States().end() ? nullptr : found->second.get();
+}
+
+class ResolveClient final : public network::mojom::ProxyLookupClient {
+ public:
+  ResolveClient(cef_kweb_network_resolve_callback_t callback, void* user_data)
+      : callback_(callback), user_data_(user_data) {}
+
+  void OnProxyLookupComplete(int32_t net_error,
+                             network::mojom::ProxyInfoPtr proxy_info) override {
+    std::string result;
+    cef_kweb_network_status_t status = CEF_KWEB_NETWORK_STATUS_OK;
+    if (net_error != 0 || !proxy_info) {
+      status = CEF_KWEB_NETWORK_STATUS_PROXY_RESOLVE_FAILED;
+    } else {
+      net::ProxyList proxy_list;
+      for (const auto& chain : (*proxy_info)->proxy_chains) {
+        if (!chain || !chain->proxy_servers) {
+          status = CEF_KWEB_NETWORK_STATUS_PROXY_RESOLVE_FAILED;
+          break;
+        }
+        if (chain->proxy_servers->empty()) {
+          proxy_list.AddProxyChain(net::ProxyChain::Direct());
+          continue;
+        }
+        if (chain->proxy_servers->size() != 1 ||
+            !chain->proxy_servers->front() ||
+            !chain->proxy_servers->front()->host_and_port) {
+          status = CEF_KWEB_NETWORK_STATUS_PROXY_RESOLVE_FAILED;
+          break;
+        }
+        const auto& server = chain->proxy_servers->front();
+        net::ProxyServer::Scheme scheme;
+        switch (server->scheme) {
+          case network::mojom::ProxyScheme::kHttp:
+            scheme = net::ProxyServer::SCHEME_HTTP;
+            break;
+          case network::mojom::ProxyScheme::kHttps:
+            scheme = net::ProxyServer::SCHEME_HTTPS;
+            break;
+          case network::mojom::ProxyScheme::kSocks4:
+            scheme = net::ProxyServer::SCHEME_SOCKS4;
+            break;
+          case network::mojom::ProxyScheme::kSocks5:
+            scheme = net::ProxyServer::SCHEME_SOCKS5;
+            break;
+          case network::mojom::ProxyScheme::kQuic:
+            scheme = net::ProxyServer::SCHEME_QUIC;
+            break;
+          default:
+            status = CEF_KWEB_NETWORK_STATUS_PROXY_RESOLVE_FAILED;
+            break;
+        }
+        if (status != CEF_KWEB_NETWORK_STATUS_OK) {
+          break;
+        }
+        auto parsed_chain = net::ProxyChain::FromSchemeHostAndPort(
+            scheme, server->host_and_port->host, server->host_and_port->port);
+        if (!parsed_chain.IsValid()) {
+          status = CEF_KWEB_NETWORK_STATUS_PROXY_RESOLVE_FAILED;
+          break;
+        }
+        proxy_list.AddProxyChain(std::move(parsed_chain));
+      }
+      if (status == CEF_KWEB_NETWORK_STATUS_OK && proxy_list.IsEmpty()) {
+        status = CEF_KWEB_NETWORK_STATUS_PROXY_RESOLVE_FAILED;
+      }
+      if (status == CEF_KWEB_NETWORK_STATUS_OK) {
+        result = proxy_list.ToPacString();
+      }
+    }
+    callback_(user_data_, status, {result.data(), result.size()});
+  }
+
+ private:
+  const cef_kweb_network_resolve_callback_t callback_;
+  void* const user_data_;
+};
+
+}  // namespace
+
+namespace kweb_network {
+
+bool ConfigureNetworkContextParams(
+    const base::FilePath& profile_path,
+    network::mojom::NetworkContextParams* params) {
+  CEF_REQUIRE_UIT();
+  ProfileState* state = FindState(profile_path);
+  if (!state) {
+    auto created = std::make_unique<ProfileState>();
+    state = created.get();
+    States().emplace(profile_path, std::move(created));
+  }
+  if (!state->default_accept_language_captured) {
+    state->default_accept_language = params->accept_language;
+    state->default_accept_language_captured = true;
+  }
+  state->network_context_created = true;
+  params->initial_proxy_config = state->configured
+                                     ? state->proxy_config
+                                     : net::ProxyConfigWithAnnotation(
+                                           net::ProxyConfig::CreateDirect(),
+                                           TrafficAnnotation());
+  mojo::PendingRemote<network::mojom::ProxyConfigClient> remote;
+  params->proxy_config_client_receiver =
+      remote.InitWithNewPipeAndPassReceiver();
+  state->proxy_clients.Add(std::move(remote));
+  if (state->configured && !state->user_agent.empty()) {
+    params->user_agent = state->user_agent;
+  }
+  if (state->configured && !state->accept_language.empty()) {
+    params->accept_language = state->accept_language;
+  }
+  return true;
+}
+
+}  // namespace kweb_network
+
+extern "C" {
+
+CEF_EXPORT const char* cef_kweb_network_abi_fingerprint(void) {
+  return CEF_KWEB_NETWORK_ABI_FINGERPRINT;
+}
+
+CEF_EXPORT cef_kweb_network_status_t
+cef_kweb_network_set_config(const cef_kweb_network_proxy_config_t* config) {
+  if (!config || config->struct_size < sizeof(*config) ||
+      config->abi_version != CEF_KWEB_NETWORK_ABI_VERSION ||
+      !CEF_CURRENTLY_ON_UIT()) {
+    return config && !CEF_CURRENTLY_ON_UIT()
+               ? CEF_KWEB_NETWORK_STATUS_WRONG_THREAD
+               : CEF_KWEB_NETWORK_STATUS_INVALID_ARGUMENT;
+  }
+  const std::string profile_string =
+      CopyString(config->profile_path, kMaximumPathSize, true);
+  if (profile_string.empty()) {
+    return CEF_KWEB_NETWORK_STATUS_INVALID_ARGUMENT;
+  }
+  const base::FilePath profile_path = PathFromString(profile_string);
+  auto proxy_config = BuildProxyConfig(*config);
+  if (!proxy_config) {
+    return CEF_KWEB_NETWORK_STATUS_PROXY_INVALID;
+  }
+  const std::string user_agent =
+      CopyString(config->user_agent, kMaximumUserAgentSize, false);
+  const std::string accept_language =
+      CopyString(config->accept_language, kMaximumAcceptLanguageSize, false);
+  if (config->user_agent.size != 0 && user_agent.empty()) {
+    return CEF_KWEB_NETWORK_STATUS_INVALID_ARGUMENT;
+  }
+  if (config->accept_language.size != 0 && accept_language.empty()) {
+    return CEF_KWEB_NETWORK_STATUS_INVALID_ARGUMENT;
+  }
+  if (!IsSafeNetworkContextValue(user_agent) ||
+      !IsSafeNetworkContextValue(accept_language)) {
+    return CEF_KWEB_NETWORK_STATUS_INVALID_ARGUMENT;
+  }
+  ProfileState* state = FindState(profile_path);
+  if (!state) {
+    auto created = std::make_unique<ProfileState>();
+    state = created.get();
+    States().emplace(profile_path, std::move(created));
+  }
+  if (auto* context = CefBrowserContext::FromCachePath(profile_path)) {
+    state->network_context_created = state->network_context_created ||
+                                     context->GetNetworkContext() != nullptr;
+  }
+  if (state->network_context_created && state->user_agent != user_agent) {
+    return CEF_KWEB_NETWORK_STATUS_USER_AGENT_LOCKED;
+  }
+  state->proxy_config = std::move(*proxy_config);
+  state->user_agent = user_agent;
+  state->accept_language = accept_language;
+  state->configured = true;
+  for (const auto& client : state->proxy_clients) {
+    client->OnProxyConfigUpdated(state->proxy_config);
+  }
+  if (auto* context = CefBrowserContext::FromCachePath(profile_path)) {
+    if (auto* network_context = context->GetNetworkContext()) {
+      network_context->SetAcceptLanguage(
+          accept_language.empty() ? state->default_accept_language
+                                  : accept_language);
+    }
+  }
+  return CEF_KWEB_NETWORK_STATUS_OK;
+}
+
+CEF_EXPORT cef_kweb_network_status_t cef_kweb_network_resolve_proxy(
+    cef_kweb_network_string_view_t profile_path_value,
+    cef_kweb_network_string_view_t url_value,
+    cef_kweb_network_resolve_callback_t callback,
+    void* user_data) {
+  if (!callback || !CEF_CURRENTLY_ON_UIT()) {
+    return callback ? CEF_KWEB_NETWORK_STATUS_WRONG_THREAD
+                    : CEF_KWEB_NETWORK_STATUS_INVALID_ARGUMENT;
+  }
+  const std::string profile_string =
+      CopyString(profile_path_value, kMaximumPathSize, true);
+  const std::string url_string =
+      CopyString(url_value, kMaximumPacUrlSize, true);
+  if (profile_string.empty() || url_string.empty()) {
+    return CEF_KWEB_NETWORK_STATUS_INVALID_ARGUMENT;
+  }
+  const GURL url(url_string);
+  if (!url.is_valid() || (!url.SchemeIs("http") && !url.SchemeIs("https")) ||
+      url.has_username() || url.has_password()) {
+    return CEF_KWEB_NETWORK_STATUS_INVALID_ARGUMENT;
+  }
+  auto* context =
+      CefBrowserContext::FromCachePath(PathFromString(profile_string));
+  if (!context || !context->GetNetworkContext()) {
+    return CEF_KWEB_NETWORK_STATUS_PROFILE_NOT_FOUND;
+  }
+  mojo::PendingRemote<network::mojom::ProxyLookupClient> remote;
+  auto client = std::make_unique<ResolveClient>(callback, user_data);
+  auto receiver = remote.InitWithNewPipeAndPassReceiver();
+  mojo::MakeSelfOwnedReceiver(std::move(client), std::move(receiver));
+  context->GetNetworkContext()->LookUpProxyForURL(
+      url, net::NetworkAnonymizationKey(), std::move(remote));
+  return CEF_KWEB_NETWORK_STATUS_OK;
+}
+
+CEF_EXPORT cef_kweb_network_status_t cef_kweb_network_clear_config(
+    cef_kweb_network_string_view_t profile_path_value) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    return CEF_KWEB_NETWORK_STATUS_WRONG_THREAD;
+  }
+  const std::string profile_string =
+      CopyString(profile_path_value, kMaximumPathSize, true);
+  if (profile_string.empty()) {
+    return CEF_KWEB_NETWORK_STATUS_INVALID_ARGUMENT;
+  }
+  States().erase(PathFromString(profile_string));
+  return CEF_KWEB_NETWORK_STATUS_OK;
+}
+
+}  // extern "C"

